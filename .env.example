# Autonomous SEO agent
# Set these in your hosting provider; never commit real secrets.
SEO_AGENT_CRON_SECRET=replace-with-a-long-random-secret
SEO_SEARCH_API_URL=https://your-search-provider.example/search
SEO_SEARCH_API_KEY=replace-with-provider-key

# First-party Instagram API service
# Point this at the warm Node service under services/instagram-api.
INSTAGRAM_API_URL=https://your-instagram-api.example
INSTAGRAM_API_KEY=replace-with-a-long-random-secret

# Optional direct extraction fallback
APIFY_API_TOKEN=
DOWNLOAD_RATE_LIMIT=20

# Optional production object storage (Cloudflare R2 / S3-compatible)
# When configured, InstaFetch can mirror media into R2 before serving it.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=instafetch-media
